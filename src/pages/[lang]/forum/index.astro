---
import Base from '../../../layouts/Base.astro';
import Forum from '../../../components/Forum.astro';
import { LANGS, t } from '../../../i18n/ui.js';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params; const T = t(lang);
---
<Base lang={lang} title={T.forum_title} description={T.forum_intro} path="forum/">
  <section class="section wrap"><h1 style="font-size:var(--step-3);margin-bottom:24px">{T.forum_title}</h1><Forum lang={lang} fete="" title={T.forum_latest} /></section>
</Base>
