---
import '../styles/global.css';
import { LANGS, LANG_NAMES, RTL, t } from '../i18n/ui.js';
const { lang, title, description = '', path = '', jsonld = null, image = null } = Astro.props;
const T = t(lang);
const site = 'https://fiesta365.org';
const url = `${site}/${lang}/${path}`;
const fonts = {
  ar: '&family=Noto+Naskh+Arabic:wght@400;600', hi: '&family=Noto+Sans+Devanagari:wght@400;600',
  bn: '&family=Noto+Sans+Bengali:wght@400;600', zh: '&family=Noto+Sans+SC:wght@400;600&family=Noto+Serif+SC:wght@500',
}[lang] || '';
const nav = [['', T.nav_home], ['map/', T.nav_map], ['calendar/', T.nav_calendar], ['search/', T.nav_search], ['forum/', T.nav_forum]];
const isCur = (p) => (p === '' ? path === '' : path.startsWith(p));
const fullTitle = path === '' ? `Fiesta365 · ${T.tagline}` : `${title} · Fiesta365`;
---
<!DOCTYPE html>
<html lang={lang} dir={RTL.has(lang) ? 'rtl' : 'ltr'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description || T.tagline} />
  <link rel="canonical" href={url} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${site}/${l}/${path}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}/fr/${path}`} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Fiesta365" />
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description || T.tagline} />
  <meta property="og:url" content={url} />{image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#121A3A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1${fonts}&display=swap`} />
  <script is:inline>try{var s=localStorage.getItem('f365-theme');if(s)document.documentElement.dataset.theme=s}catch(e){}</script>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="skip" href="#main">{T.skip}</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={`/${lang}/`} aria-label="Fiesta365">
        <svg viewBox="0 0 32 32" aria-hidden="true"><g fill="#E8A33D"><polygon points="16,1 19.5,10 29,6.5 23.5,15 31,20 21.5,20.5 22,30 16,23 10,30 10.5,20.5 1,20 8.5,15 3,6.5 12.5,10"/></g><circle cx="16" cy="16" r="4" fill="#B8306E"/></svg>
        <span>Fiesta<b>365</b></span>
      </a>
      <nav class="nav" id="nav" aria-label="Navigation">
        {nav.map(([p, label]) => <a href={`/${lang}/${p}`} aria-current={isCur(p) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="tools">
        <label class="sr" for="langsel">{T.lang_label}</label>
        <select id="langsel" data-path={path} aria-label={T.lang_label}>
          {LANGS.map((l) => <option value={l} selected={l === lang} lang={l}>{LANG_NAMES[l]}</option>)}
        </select>
        <button class="iconbtn" id="themebtn" type="button" aria-label={T.theme}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg></button>
        <button class="iconbtn menubtn" id="menubtn" type="button" aria-controls="nav" aria-expanded="false" aria-label={T.menu}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg></button>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <div><p><strong>Fiesta365</strong> · {T.footer_about}</p><p style="margin-top:8px">{T.footer_licences}</p></div>
      <ul><li><a href={`/${lang}/map/`}>{T.nav_map}</a></li><li><a href={`/${lang}/calendar/`}>{T.nav_calendar}</a></li><li><a href={`/${lang}/forum/`}>{T.nav_forum}</a></li></ul>
      <ul><li><a href={`/${lang}/about/`}>{T.nav_about}</a></li><li><a href={`/${lang}/contact/`}>{T.nav_contact}</a></li><li><a href={`/${lang}/legal/`}>{T.legal_title}</a></li></ul>
    </div>
  </footer>
  <script is:inline>
  (function(){
    var sel=document.getElementById('langsel');
    sel&&sel.addEventListener('change',function(){var p=sel.dataset.path||'';var base=document.documentElement.dataset.base||'/';location.href=base+sel.value+'/'+p+(document.documentElement.dataset.idx||'');});
    var tb=document.getElementById('themebtn');
    tb&&tb.addEventListener('click',function(){var d=document.documentElement;var dark=d.dataset.theme?d.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;d.dataset.theme=dark?'light':'dark';try{localStorage.setItem('f365-theme',d.dataset.theme)}catch(e){}});
    var mb=document.getElementById('menubtn'),nav=document.getElementById('nav');
    mb&&mb.addEventListener('click',function(){var o=nav.classList.toggle('open');mb.setAttribute('aria-expanded',o)});
  })();
  </script>
</body>
</html>
