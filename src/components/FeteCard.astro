---
import { t, LOCALES } from '../i18n/ui.js';
import { L, nameOf, fmtRange, commonsImg } from '../lib/data.js';
const { lang, f, big = false } = Astro.props;
const T = t(lang);
const ph = f.photos.find((p) => p.role === 'fete') || f.photos[0];
const name = nameOf(f, lang);
---
<article class={`card${big ? ' big' : ''}`} data-k={f.continent} data-t={f.category} data-a={f.dates[0].start} data-b={f.dates[0].end}>
  <div class="art" style={`background-image:url(/posters/${f.slug}.svg)`}>
    {ph && <img src={commonsImg(ph.file, big ? 900 : 600)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()" />}
  </div>
  <div class="body">
    <span class="when">{fmtRange(f, LOCALES[lang])}</span>
    <h3 dir="auto"><a href={`/${lang}/festivals/${f.slug}/`}>{name}</a></h3>
    <span class="where" dir="auto">{f.place} · {L(f.country, lang).text}</span>
    <div class="tags"><span class="tag">{T.cat_l[f.category]}</span><span class="tag">{T.fame_l[f.fame]}</span></div>
  </div>
</article>
