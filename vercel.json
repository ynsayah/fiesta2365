{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/v2", "destination": "/fr/", "permanent": true },
    { "source": "/v2/:lang(fr|en|es|zh|hi|ar|ru|pt|bn|de)/festivals/:slug", "destination": "/:lang/search/?q=:slug", "permanent": true },
    { "source": "/v2/:lang(fr|en|es|zh|hi|ar|ru|pt|bn|de)/calendar", "destination": "/:lang/calendar/", "permanent": true },
    { "source": "/v2/:lang(fr|en|es|zh|hi|ar|ru|pt|bn|de)/:rest*", "destination": "/:lang/", "permanent": true },
    { "source": "/v2/:rest*", "destination": "/fr/", "permanent": true },
    { "source": "/:y(\\d{4})/:m(\\d{2})/:d(\\d{2})/:slug", "destination": "/fr/search/?q=:slug", "permanent": true },
    { "source": "/category/:rest*", "destination": "/fr/", "permanent": true },
    { "source": "/:p(calendrier|calendar)", "destination": "/fr/calendar/", "permanent": true },
    { "source": "/:p(toutes-les-fetes|fetes)", "destination": "/fr/search/", "permanent": true },
    { "source": "/feed", "destination": "/fr/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/posters/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/world.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
